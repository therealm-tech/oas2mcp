{
  "realm": "oas2mcp",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Every tool"
      },
      {
        "name": "reader",
        "description": "Read-only tools"
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "oneaccess",
      "displayName": "OneAccess (fixture)",
      "providerId": "jwt-authorization-grant",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "config": {
        "jwtAuthorizationGrantEnabled": "true",
        "issuer": "https://oneaccess.example/",
        "useJwksUrl": "false",
        "validateSignature": "true",
        "jwtAuthorizationGrantAssertionSignatureAlg": "RS256",
        "jwtAuthorizationGrantAssertionReuseAllowed": "false",
        "jwtAuthorizationGrantMaxAllowedAssertionExpiration": "600",
        "jwtAuthorizationGrantAllowedClockSkew": "30",
        "publicKeySignatureVerifier": "",
        "publicKeySignatureVerifierKeyId": "oneaccess-key"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "alice-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ],
      "federatedIdentities": [
        {
          "identityProvider": "oneaccess",
          "userId": "oneaccess-alice",
          "userName": "alice"
        }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Reader",
      "credentials": [
        {
          "type": "password",
          "value": "bob-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "reader"
      ],
      "federatedIdentities": [
        {
          "identityProvider": "oneaccess",
          "userId": "oneaccess-bob",
          "userName": "bob"
        }
      ]
    },
    {
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "email": "carol@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "carol-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "reader"
      ]
    },
    {
      "username": "dave",
      "enabled": true,
      "emailVerified": true,
      "email": "dave@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "dave-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "reader"
      ],
      "federatedIdentities": [
        {
          "identityProvider": "oneaccess",
          "userId": "oneaccess-dave",
          "userName": "dave"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "oas2mcp-upstream",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "upstream-secret",
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "oauth2.jwt.authorization.grant.enabled": "true",
        "oauth2.jwt.authorization.grant.idp": "oneaccess"
      },
      "protocolMappers": [
        {
          "name": "flat-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-sandbox-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sandbox-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "oas2mcp-doc",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "jwt.credential.certificate": "",
        "token.endpoint.auth.signing.alg": "RS256"
      },
      "protocolMappers": [
        {
          "name": "aud-sandbox-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "sandbox-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mcp-client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {},
      "protocolMappers": [
        {
          "name": "flat-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "aud-oas2mcp-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "oas2mcp-server",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
